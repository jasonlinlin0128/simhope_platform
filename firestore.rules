rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // 自建 users 文件時，role 必須「不存在」或為 'viewer'（擋自我提權成 developer/admin）
    function roleIsViewerOrAbsent(data) {
      return !('role' in data.keys()) || data.role == 'viewer';
    }

    // 欄位不變式：非 admin 編輯自己文件時必須成立。
    // status / authorUid 用 plain equality（fail-closed：現值缺欄位→error→作者分支false→只有admin能改）。
    // createdAt 用 guarded（不敏感、舊文件可能缺，避免誤擋內容編輯）。
    function statusUnchanged() {
      return request.resource.data.status == resource.data.status;
    }
    function authorUidUnchanged() {
      return request.resource.data.authorUid == resource.data.authorUid;
    }
    function createdAtUnchanged() {
      return !('createdAt' in resource.data.keys())
        || request.resource.data.createdAt == resource.data.createdAt;
    }

    // Users:
    //   讀：登入即可（admin 後台需列使用者）
    //   建：本人只能建「無 role / viewer」文件（首次 Google 登入自動建）；admin 可建任意 role
    //   改：本人不可改自己的 role；admin 可改任何人
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && roleIsViewerOrAbsent(request.resource.data)) ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && !('role' in request.resource.data.diff(resource.data).affectedKeys())) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Tools（＝入口網 Application Registry）：
    //   讀：**只有 visibility=PUBLIC_ALL 的公開狀態**人人可讀（首頁/hub 的匿名 REST 走這裡）；
    //       受限的 app（BY_RULE / HIDDEN）client 一律讀不到——它們由 /api/apps 以 Admin SDK
    //       按身分（canSeeApp）過濾後才下發，受限資料不得落入任何 client payload。
    //       未公開（pending）與受限 app 仍只有作者/admin 可讀（/dashboard、/admin、健檢看板靠這條）。
    //   ⚠️ visibility 缺欄位的舊文件無法被等值查詢命中 → 上這條規則前，
    //      必須先跑 scripts/migrate-tools-portal-fields.mjs --apply（見 PR 說明的順序）。
    match /tools/{toolId} {
      allow read: if (resource.data.visibility == 'PUBLIC_ALL'
          && resource.data.status in ['live', 'beta', 'new', 'dev', 'terminated'])
        || (isSignedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin();
      // 建立時**強制**帶 visibility=PUBLIC_ALL：沒有這個欄位的工具，過審後既不會被
      // 首頁的等值查詢命中、也讀不到 → 靜默從站上消失。與其信任每條建立路徑都記得寫，
      // 不如讓忘記寫的當場失敗。要設成受限（BY_RULE/HIDDEN）由 admin 事後改。
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['developer', 'admin']
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.visibility == 'PUBLIC_ALL';
      allow update: if isSignedIn() && (
        ( resource.data.authorUid == request.auth.uid
          && authorUidUnchanged()
          && statusUnchanged()
          && createdAtUnchanged() )
        || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );
    }

    // Pain Cards: 已核准人人可讀；未核准只有作者/admin 可讀（用 approval 欄位）。
    match /painCards/{cardId} {
      allow read: if resource.data.approval == 'approved'
        || (isSignedIn() && resource.data.authorUid == request.auth.uid)
        || isAdmin();
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['developer', 'admin']
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.approval == 'pending';
      // 無 client 端 painCard 編輯/刪除流程（前台只讀）；作者自核准 approval 屬越權。
      // update/delete 一律僅 admin（不開作者分支，避免越權 + 不必要的攻擊面）。
      allow update, delete: if isAdmin();
    }

    // FAQ：公開可讀；僅 admin 可寫（前端後台 CRUD）
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 申請/需求：client 不可建（只 server Admin SDK 建，防偽造）；
    //   讀：admin 全讀，或登入者讀自己的（uid 相符；匿名 request 無 uid → 僅 admin）；
    //   改/刪：僅 admin。
    match /requests/{reqId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // Passkeys / WebAuthn challenges: 只有 Admin SDK（伺服器端）能存取。
    // client 一律拒絕（公鑰庫與 challenge 不可被前端讀寫）。
    match /passkeys/{id} {
      allow read, write: if false;
    }
    match /webauthnChallenges/{id} {
      allow read, write: if false;
    }

    // 👍 有幫助去重記錄（per-uid-per-tool）：只有 Admin SDK（/api/tool-helpful）能存取。
    // client 一律拒絕——若使用者能自行刪除自己的投票記錄，就能重複投票灌爆公開 badge。
    match /helpfulVotes/{id} {
      allow read, write: if false;
    }

    // 員工母檔（HR 名冊匯入）：含個資與啟用狀態，只有 Admin SDK（伺服器端）能存取。
    // client 一律拒絕——啟用驗證/停用封鎖都走後端 API，前端不需要也不可以直讀。
    match /employees/{employeeId} {
      allow read, write: if false;
    }

    // 稽核記錄：append-only，只有 Admin SDK 能寫，admin 經 /api/admin/audit-logs 讀。
    // client 一律拒絕——稽核紀錄若能被當事人讀寫/刪除，就失去舉證意義。
    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // 部門：登入者可讀（入口網按部門過濾顯示用）；僅 admin 可寫。
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 使用數據：累計數公開可讀（首頁顯示）；每日明細僅 admin 讀；
    // 一律禁止 client 寫（只 Admin SDK 經 /api/track 寫，防灌水）。
    match /analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /analytics_daily/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
